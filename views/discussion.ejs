<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discussion | PingVerse</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Roboto', sans-serif; }
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: -1;
        }
    </style>
</head>
<body>
    <!-- Video Background -->
    <div class="HomeNew_backgroundGradient__Gqlhy BackgroundGradient_backgroundGradientWrapper__VhcUn">
        <video class="video-background" autoplay loop muted playsinline
               src="https://l4wlsi8vxy8hre4v.public.blob.vercel-storage.com/video/glass-animation-5-f0gPcjmKFIV3ot5MGOdNy2r4QHBoXt.mp4">
        </video>
        <div class="overlay"></div>
    </div>

    <!-- Header -->
    <header class="bg-gray-900 text-white py-4 shadow-md relative z-10">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <h1 class="text-lg font-bold tracking-wide">
                Welcome, <%= user.username %>
            </h1>
            <nav class="flex space-x-4">
                <a href="/" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full shadow-lg flex items-center transition-transform transform hover:scale-105">
                    <i class="fas fa-home mr-2"></i>
                    <span class="hidden sm:inline">Home</span>
                </a>
                <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-full shadow-lg flex items-center transition-transform transform hover:scale-105">
                    <i class="fas fa-sign-out-alt mr-2"></i>
                    <span class="hidden sm:inline">Logout</span>
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8 relative z-10 h-screen flex flex-col">
      

        <!-- Discussion Container -->
        <div class="bg-white bg-opacity-50 rounded-lg shadow-md p-6 mb-6 flex-grow flex flex-col fixed inset-0 top-20 bottom-16 mx-4">
            <!-- Create New Discussion -->
            <div class="bg-white rounded-lg shadow-md p-4 mb-4">
                <form id="discussionForm" class="space-y-4">
                    <div>
                        <input type="text" 
                               id="title" 
                               placeholder="Discussion Title" 
                               class="w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                               required>
                    </div>
                    <div>
                        <textarea id="content" 
                                  placeholder="What's on your mind?" 
                                  class="w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 h-24"
                                  required></textarea>
                    </div>
                    <button type="submit" 
                            class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-colors w-full sm:w-auto">
                        Post Discussion
                    </button>
                </form>
            </div>

            <!-- Discussions List -->
            <div class="flex-grow overflow-y-auto space-y-4" id="discussionsList">
                <% discussions.forEach(discussion => { %>
                    <div class="bg-white rounded-lg shadow-md p-4">
                        <div class="flex items-start space-x-3">
                            <div class="flex-shrink-0">
                                <div class="w-10 h-10 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold">
                                    <%= discussion.author.charAt(0).toUpperCase() %>
                                </div>
                            </div>
                            <div class="flex-grow">
                                <h3 class="text-lg font-semibold text-gray-900"><%= discussion.title %></h3>
                                <p class="text-gray-600 mt-1"><%= discussion.content %></p>
                                <div class="mt-2 text-sm text-gray-500">
                                    Posted by <%= discussion.author %> on <%= new Date(discussion.createdAt).toLocaleDateString() %>
                                </div>
                                
                                <!-- Replies Section -->
                                <div class="mt-4 space-y-3">
                                    <% discussion.replies.forEach(reply => { %>
                                        <div class="bg-gray-50 rounded-lg p-3 ml-8">
                                            <div class="flex items-start space-x-3">
                                                <div class="flex-shrink-0">
                                                    <div class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold">
                                                        <%= reply.author.charAt(0).toUpperCase() %>
                                                    </div>
                                                </div>
                                                <div>
                                                    <p class="text-gray-800"><%= reply.content %></p>
                                                    <div class="text-xs text-gray-500 mt-1">
                                                        Replied by <%= reply.author %> on <%= new Date(reply.createdAt).toLocaleDateString() %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>

                                <!-- Reply Form -->
                                <div class="mt-3">
                                    <form class="reply-form flex space-x-2">
                                        <input type="hidden" value="<%= discussion._id %>" class="discussion-id">
                                        <input type="text" 
                                               placeholder="Write a reply..." 
                                               class="flex-grow p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                                        <button type="submit" 
                                                class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 text-sm">
                                            Reply
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </main>

    <!-- Bottom Navigation -->
    <div class="fixed bottom-0 left-0 right-0 bg-gray-800 shadow-lg z-50">
        <div class="flex justify-around py-2">
            <a class="flex flex-col items-center text-gray-300 hover:text-blue-400" href="/">
                <i class="fas fa-home text-xl"></i>
                <span class="text-xs">Feed</span>
            </a>
            <a class="flex flex-col items-center text-blue-400" href="/discussion">
                <i class="fas fa-comments text-xl"></i>
                <span class="text-xs">Discussion</span>
            </a>
            <a class="flex flex-col items-center text-gray-300 hover:text-blue-400" href="/profile">
                <i class="fas fa-user text-xl"></i>
                <span class="text-xs">Profile</span>
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const discussionForm = document.getElementById('discussionForm');
            const replyForms = document.querySelectorAll('.reply-form');

            discussionForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const title = document.getElementById('title').value;
                const content = document.getElementById('content').value;

                try {
                    const response = await fetch('/api/discussions', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ title, content })
                    });

                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Error creating discussion');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error creating discussion');
                }
            });

            replyForms.forEach(form => {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const discussionId = this.querySelector('.discussion-id').value;
                    const content = this.querySelector('input[type="text"]').value;

                    try {
                        const response = await fetch(`/api/discussions/${discussionId}/replies`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ content })
                        });

                        if (response.ok) {
                            window.location.reload();
                        } else {
                            alert('Error posting reply');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Error posting reply');
                    }
                });
            });
        });
    </script>
</body>
</html>
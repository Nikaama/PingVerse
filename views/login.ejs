<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Character encoding and viewport settings -->
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Login | PingVerse</title>
    
    <!-- TailwindCSS CDN for styling -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="manifest" href="/manifest.json">
    
    <!-- Font Awesome CDN for icon usage -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    
    <style>
        /* Ensure the video covers the entire viewport */
        .video-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1; /* Ensure it sits behind other content */
        }
        
        /* Overlay to darken the video background for better contrast */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5); /* Dark background */
            z-index: 0;
        }
    </style>
</head>
<body class="min-h-screen relative">

    <!-- Video Background Section -->
    <div class="HomeNew_backgroundGradient__Gqlhy BackgroundGradient_backgroundGradientWrapper__VhcUn">
        <video class="video-background" autoplay loop muted playsinline
               src="https://l4wlsi8vxy8hre4v.public.blob.vercel-storage.com/video/glass-animation-5-f0gPcjmKFIV3ot5MGOdNy2r4QHBoXt.mp4">
        </video>
        
        <!-- Overlay for better visibility of text and form -->
        <div class="overlay"></div>
    </div>

    <!-- Centered Login Form -->
    <div class="flex items-center justify-center min-h-screen relative z-10">
        <div class="bg-white bg-opacity-50 p-8 rounded-lg shadow-lg w-full max-w-sm">
            <!-- Login Form Title -->
            <h1 class="text-2xl font-bold mb-4 text-center">Login</h1>
            
            <!-- Login Form -->
            <form action="/login" method="POST" class="space-y-4">
                <!-- Email Input -->
                <div>
                    <label for="email" class="block text-sm font-medium">Email:</label>
                    <input type="email" name="email" id="email" required
                           class="w-full px-4 py-2 border rounded-lg focus:ring focus:ring-blue-300">
                </div>

                <!-- Password Input with Visibility Toggle -->
                <div>
                    <label for="password" class="block text-sm font-medium">Password:</label>
                    <div class="relative">
                        <input type="password" name="password" id="password" required
                               class="w-full px-4 py-2 border rounded-lg focus:ring focus:ring-blue-300">
                        
                        <!-- Button to toggle password visibility -->
                        <button type="button" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-600" onclick="togglePasswordVisibility()">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600">
                    Login
                </button>

                <!-- Display Error Message if Provided -->
                <% if (message) { %>
                    <p class="text-red-500 text-sm mt-2"><%= message %></p>
                <% } %>
            </form>

            <!-- Sign up Link for new users -->
            <p class="mt-4 text-sm text-center">Don't have an account? <a href="/signup" class="text-blue-500 hover:underline">Sign up</a></p>
        </div>
    </div>

    <!-- Password Visibility Toggle Script -->
    <script>
        function togglePasswordVisibility() {
            const passwordField = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            
            // Toggle between password and text input type
            if (passwordField.type === 'password') {
                passwordField.type = 'text'; // Show password
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash'); // Change icon to 'eye-slash'
            } else {
                passwordField.type = 'password'; // Hide password
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye'); // Change icon back to 'eye'
            }
        }
    </script>
    <script>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
              .then(reg => console.log("Service Worker Registered"))
              .catch(err => console.log("Service Worker Registration Failed", err));
          });
        }
      </script>
</body>
</html>